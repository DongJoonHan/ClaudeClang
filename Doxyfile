# Doxygen 설정 — 주석 검증과 문서 생성
# INPUT은 ci/scripts/check-doxygen.sh가 존재하는 디렉터리만 골라 덧붙인다.

PROJECT_NAME           = "ClaudeClang"
OUTPUT_DIRECTORY       = build/doxygen
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.hpp *.cpp *.cc *.cxx
EXCLUDE_PATTERNS       = */build/*
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
QUIET                  = YES

# 경고는 오류로 취급한다 (문서화되지 않은 공개 항목, 잘못된 태그 등)
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

# Human-in-the-Loop 태그 (CLAUDE.md 2.4절) 및 시험 주석 태그
ALIASES  = "ai_model=\par AI 모델:^^"
ALIASES += "ai_date=\par 작성 일시:^^"
ALIASES += "requested_by=\par 요청자:^^"
ALIASES += "human_reviewed=\par 사용자 리뷰 완료 여부:^^"
ALIASES += "reviewed_by=\par 리뷰어:^^"
ALIASES += "reviewed_date=\par 리뷰 일자:^^"
ALIASES += "satisfies=\par 추적 ID:^^"
ALIASES += "technique=\par 시험 기법:^^"
ALIASES += "input=\par 입력값:^^"
ALIASES += "procedure=\par 절차:^^"
ALIASES += "expected=\par 예상 출력값:^^"
